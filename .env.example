# Copy to .env (never commit .env). All values below are PLACEHOLDERS.

# Price data provider: "sample" (default, clearly-labelled demo prices) or "live"
PRICE_PROVIDER=sample

# Server port for the local API (frontend proxies /api here)
API_PORT=8787

# --- Live mode (only used when PRICE_PROVIDER=live) ---
# Station-level Swiss prices are NOT freely available; you need a data
# contract (see README "Going live"). Keep keys server-side ONLY.
TANKBILLIG_API_KEY=your-p…here
FUEL_PRICE_API_KEY=your-p…here
